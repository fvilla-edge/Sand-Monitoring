# modo-evento.service — supervisor del modo evento (captura continua,
# docs/modo_evento.md). Arranca solo al encender la placa y relanza
# capturar_eventos si se cae (SIGSEGV del vendor, streaming-server caido,
# lo que sea), sin rendirse nunca: StartLimitIntervalSec=0 anula el limite
# de reintentos de systemd — en campo, rendirse = quedar sin medir hasta que
# alguien entre por SSH.
#
# RestartSec=60: espacio entre arranques pedido por el usuario (2026-09-24);
# lanzar sesiones en rafaga deja el streaming-server residual (visto en
# rp-f0fbda y rp-f0fd8c). Cada relanzamiento recarga el bitstream, asi que el
# window_count vuelve a empezar: el CSV queda con un hueco de ~60s+arranque y
# ventanas_a_paquete.py lo separa en tramos.
#
# OJO: el streaming-server acepta UN solo cliente. Con este servicio activo no
# se puede correr capturar_stream.py en la misma placa:
#   systemctl disable --now modo-evento   (y al reves: enable --now)
#
# Destino, umbral, canales y decimacion: editar Environment= (o un drop-in
# con systemctl edit). Cambiar = reiniciar el servicio (hueco de ~60s+arranque
# en el CSV); el server recibe la configuracion de canales al conectar.
# Instalar:
#   cp /root/scripts_campo/systemd/modo-evento.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now modo-evento
[Unit]
Description=Modo evento: captura continua, guarda la señal cruda solo si kurtosis>=umbral
StartLimitIntervalSec=0
# Al boot, redpitaya_e3_controller carga su propio overlay de la FPGA; si el
# nuestro llega a la vez, overlay.sh falla con "overlays/Full: File exists" y
# el acumulador no aparece (visto en rp-f0fd8c 2026-09-24: primer arranque
# fallido, recuperado en el reintento). After= solo ordena, no exige que existan.
After=redpitaya_startup.service redpitaya_e3_controller.service

[Service]
Type=simple
# /mnt/usb: el storage externo de campo (automontaje, scripts_campo_comun/
# udev-automount). Si no hay disco, supervisor_eventos.sh arrancar mide igual
# con solo el CSV en la SD (rutas.eventos_sd, sin señal cruda) y vuelve al
# disco cuando automount_usb.sh lo monta. Si se desconecta en medio,
# capturar_eventos corta con codigo 4 (ver "Destino vigilado" en el .cpp) y
# el relanzamiento sigue en la SD.
Environment=DESTINO=/mnt/usb/eventos
# UMBRAL=3.4 desde 2026-10-05 (antes 5): pedido del usuario tras la reunion; en las
# placas ya instaladas se aplico con el drop-in modo-evento.service.d/umbral.conf
Environment=UMBRAL=3.4
# CANALES=1: solo IN1 (mono). CANALES=2: IN1 + IN2 de referencia (dual), cada
# evento guarda ademas <base>_ch2.bin. DEC (32|64) es opcional: sin DEC, mono
# va a 32 y dual a 64 (docs/plan_dos_canales.md). OJO: el umbral y el
# piso/escala de la PC estan medidos a dec32.
Environment=CANALES=1
# directorio de logs de campo: ahi caen los core dumps (core_pattern relativo)
WorkingDirectory=/root/logs_campo
LimitCORE=infinity
ExecStartPre=/bin/bash /root/scripts_campo/supervisor_eventos.sh antes
ExecStart=/bin/bash /root/scripts_campo/supervisor_eventos.sh arrancar
ExecStopPost=/bin/bash /root/scripts_campo/supervisor_eventos.sh despues
Restart=always
RestartSec=60
# supervisor_eventos.sh antes espera hasta 90s de uptime al boot (bug del
# vendor al arrancar muy temprano): el default de 90s no alcanza
TimeoutStartSec=150
# SIGTERM corta en ~1s; capturar_eventos tiene su propio vigia de 10s sobre stopStreaming
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
